# ingestion
LOAD_MODE=incremental # incremental/full
DESTINATION_BUCKET=s3://bronze

# transformation
TARGET_ENV=dev  # dev/prod
DESTINATION_PATH=/docker_app/data/processed_data
DBT_DUMP_PATH=/docker_app/data/dbt_data_dump
DBT_LOG_PATH=/docker_app/data/dbt_data_dump/logs
DBT_TARGET_PATH=/docker_app/data/dbt_data_dump/target
STATIC_DATA_PATH=/docker_app/data/static_data

# seaweed and polaris

# s3 endpoints
S3_ENDPOINT_URL_HOST=http://localhost:8333
S3_ENDPOINT_HOST=localhost:8333
S3_ENDPOINT_URL_CONTAINER=http://s3:8333
S3_ENDPOINT_CONTAINER=s3:8333
# s3 credentials
S3_ADMIN_KEY=lab-admin
S3_ADMIN_SECRET=lab-admin-secret-change-me
DLT_S3_ACCESS_KEY=dlt_access
DLT_S3_SECRET_KEY=dlt_secret_change_me
DUCKDB_S3_ACCESS_KEY=duckdb_access
DUCKDB_S3_SECRET_KEY=duckdb_secret_change_me
POLARIS_S3_ACCESS_KEY=polaris_access
POLARIS_S3_SECRET_KEY=polaris_secret_change_me
# polaris config
