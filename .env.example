# ingestion
LOAD_MODE=incremental # incremental/full

# transformation
TARGET_ENV=dev# dev/prod
DUCKDB_FILE_PATH=/docker_app/data/processed_data
DBT_DUMP_PATH=/docker_app/data/dbt_data_dump
DBT_LOG_PATH=/docker_app/data/dbt_data_dump/logs
DBT_TARGET_PATH=/docker_app/data/dbt_data_dump/target
STATIC_DATA_PATH=/docker_app/data/static_data

# seaweed and polaris

# s3 endpoints
S3_ENDPOINT_URL_HOST=http://localhost:8333
S3_ENDPOINT_HOST=localhost:8333
S3_ENDPOINT_URL_CONTAINER=http://s3:8333
S3_ENDPOINT_CONTAINER=s3:8333
# s3 credentials
S3_ADMIN_KEY=lab-admin
S3_ADMIN_SECRET=lab-admin-secret-change-me
DLT_S3_ACCESS_KEY=dlt_access
DLT_S3_SECRET_KEY=dlt_secret_change_me
DUCKDB_S3_ACCESS_KEY=duckdb_access
DUCKDB_S3_SECRET_KEY=duckdb_secret_change_me
POLARIS_S3_ACCESS_KEY=polaris_access
POLARIS_S3_SECRET_KEY=polaris_secret_change_me
# polaris config
POLARIS_TAG=1.7.0
AWS_REGION=us-east-1
POLARIS_REALM=POLARIS
POLARIS_CATALOG=usgs
BRONZE_BUCKET=s3://bronze
SILVER_BUCKET=s3://silver
GOLD_BUCKET=s3://gold
POLARIS_NAMESPACE_SILVER=usgs_silver
POLARIS_NAMESPACE_GOLD=usgs_gold
# polaris endpoints
POLARIS_ENDPOINT_URL_HOST=http://localhost:8181
POLARIS_ENDPOINT_HOST=localhost:8181
POLARIS_ENDPOINT_URL_CONTAINER=http://polaris:8181
POLARIS_ENDPOINT_CONTAINER=polaris:8181
# polaris credentials
POLARIS_ROOT=root
POLARIS_ROOT_SECRET=s3cr3t
POLARIS_POSTGRES_USER=polaris
POLARIS_POSTGRES_PASSWORD=polaris
POLARIS_PRINCIPAL=dbt-duckdb
POLARIS_PRINCIPAL_ROLE=dbt-duckdb-role
POLARIS_CATALOG_ROLE=usgs-admin
